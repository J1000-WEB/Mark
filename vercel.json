{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/auto-daily-sales-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/auto-weekly-snapshot",
      "schedule": "10 3 * * 1"
    },
    {
      "path": "/api/auto-monthly-snapshot",
      "schedule": "20 3 1 * *"
    },
    {
      "path": "/api/auto-weather",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/auto-special-offer-actuals",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/auto-weekly-target-capture",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/auto-daily-sales-check",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/api/auto-style-price-capture",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/auto-upload-staleness-check",
      "schedule": "40 3 * * *"
    }
  ]
}