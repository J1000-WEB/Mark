{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "app/api/erp-daily-sales-import/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/auto-daily-sales-snapshot/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/weekly-target-import/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/upload-style-channel-sheet/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/weekly-history/route.ts": {
      "memory": 3009,
      "maxDuration": 120
    },
    "app/api/sales-data/route.ts": {
      "memory": 3009,
      "maxDuration": 120
    },
    "app/api/data/route.ts": {
      "memory": 3009,
      "maxDuration": 120
    },
    "app/api/snapshots/route.ts": {
      "memory": 3009,
      "maxDuration": 120
    },
    "app/api/auto-weekly-snapshot/route.ts": {
      "memory": 2048,
      "maxDuration": 300
    },
    "app/api/auto-monthly-snapshot/route.ts": {
      "memory": 1024,
      "maxDuration": 120
    },
    "app/api/daily-sales/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/realtime/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/auto-realtime-hourly-snapshot/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/auto-special-offer-actuals/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/auto-daily-sales-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/auto-weekly-snapshot",
      "schedule": "10 3 * * 1"
    },
    {
      "path": "/api/auto-monthly-snapshot",
      "schedule": "20 3 1 * *"
    },
    {
      "path": "/api/auto-weather",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/auto-special-offer-actuals",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/auto-weekly-target-capture",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/auto-daily-sales-check",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/api/auto-style-price-capture",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/auto-upload-staleness-check",
      "schedule": "40 3 * * *"
    }
  ]
}