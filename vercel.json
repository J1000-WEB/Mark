{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/auto-daily-sales-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/auto-weekly-snapshot",
      "schedule": "10 3 * * 1"
    },
    {
      "path": "/api/auto-monthly-snapshot",
      "schedule": "20 3 1 * *"
    },
    {
      "path": "/api/auto-weather",
      "schedule": "30 3 * * *"
    }
  ]
}